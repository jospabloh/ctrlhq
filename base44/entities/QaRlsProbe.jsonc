{
  "description": "Sonda temporal de QA 2026-10-01; borrar.",
  "name": "QaRlsProbe",
  "properties": {
    "label": {
      "type": "string"
    },
    "tenant_ref": {
      "type": "string"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object",
  "required": []
}