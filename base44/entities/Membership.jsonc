{
  // One row per (user, business) pair — the record of who may enter which
  // tenant, and as what. This is what makes a user able to belong to several
  // businesses at once.
  //
  // WHY THIS EXISTS SEPARATELY FROM User.business_id:
  // `User.business_id` stays a single value and keeps meaning exactly what it
  // meant before — the tenant the user is operating in *right now*. Every
  // other entity's RLS still compares `data.business_id` against
  // `{{user.data.business_id}}`, unchanged, so a user can only ever read or
  // write the one tenant they are currently in. Membership only answers "which
  // tenants may I switch to", and switching is a service-role write to
  // `User.business_id` via base44/functions/switch-tenant, which re-checks
  // membership server-side.
  //
  // The deliberate consequence: isolation does not get weaker as users join
  // more tenants. Widening RLS to "business_id is in my list of memberships"
  // would have meant rewriting the rules on all 13 tenant entities and relying
  // on `$in` against an array user field, which is not a verified Base44
  // capability — a silent widening of data access is the exact failure mode
  // worth designing out.
  //
  // READ RULE, note the first branch: it is keyed on `{{user.id}}` (which comes
  // from the token) rather than on `business_id`. That is what lets the picker
  // list tenants the caller is NOT currently in — a business_id-scoped read
  // could only ever return the active tenant, which would defeat the purpose.
  "name": "Membership",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Negocio (tenant) al que pertenece esta membresía."
    },
    "user_id": {
      "type": "string",
      "description": "User.id del miembro. Es la llave contra la que el propio usuario lee sus membresías ({{user.id}}), para poder listar los negocios a los que puede entrar."
    },
    "user_email": {
      "type": "string",
      "description": "Copia del correo para poder mostrar la lista de miembros sin leer la entidad User."
    },
    "role": {
      "type": "string",
      "enum": ["business_admin", "staff"],
      "default": "staff",
      "description": "Rol del usuario DENTRO de este negocio. Al cambiar de negocio, switch-tenant copia este valor a User.role, que siempre refleja el rol en el negocio activo. No incluye 'admin': ese es el nivel de plataforma ACACIA, no un rol de inquilino (src/lib/rbac.js).",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": ["business_id", "user_id", "role"],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [{ "data.business_id": "{{user.data.business_id}}" }, { "user_condition": { "role": "business_admin" } }] }
      ]
    },
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "$and": [{ "data.business_id": "{{user.data.business_id}}" }, { "user_condition": { "role": "business_admin" } }] },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [{ "data.business_id": "{{user.data.business_id}}" }, { "user_condition": { "role": "business_admin" } }] }
      ]
    },
    "delete": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [{ "data.business_id": "{{user.data.business_id}}" }, { "user_condition": { "role": "business_admin" } }] }
      ]
    }
  }
}
