{
  "type": "object",
  "name": "Membership",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Negocio (tenant) al que pertenece esta membres\u00eda."
    },
    "user_id": {
      "type": "string",
      "description": "User.id del miembro. Es la llave contra la que el propio usuario lee sus membres\u00edas ({{user.id}}), para poder listar los negocios a los que puede entrar."
    },
    "user_email": {
      "type": "string",
      "description": "Copia del correo para poder mostrar la lista de miembros sin leer la entidad User."
    },
    "role": {
      "type": "string",
      "description": "Rol del usuario DENTRO de este negocio. Al cambiar de negocio, switch-tenant copia este valor a User.role, que siempre refleja el rol en el negocio activo. No incluye 'admin': ese es el nivel de plataforma ACACIA, no un rol de inquilino (src/lib/rbac.js).",
      "enum": [
        "business_admin",
        "staff"
      ],
      "default": "staff",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "business_id",
    "user_id",
    "role"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.business_id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.business_id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.business_id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.business_id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        }
      ]
    }
  }
}