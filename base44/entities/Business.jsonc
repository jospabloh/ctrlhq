{
  "name": "Business",
  "properties": {
    "billing_status": {
      "default": "trial",
      "description": "Escrito UNICAMENTE por el cron de licenciamiento de Mission Control (runUnifiedLifecycleForApp). CtrlHQ solo lee este campo.",
      "enum": [
        "trial",
        "active",
        "view_only",
        "suspended"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "invite_code": {
      "description": "C\u00f3digo para que el personal se una al negocio; solo lo gestiona complete-onboarding",
      "type": "string"
    },
    "license_expires_at": {
      "description": "Escrito por Mission Control.",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "license_plan": {
      "description": "Escrito por Mission Control.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "licensed_user_limit": {
      "description": "Escrito por Mission Control.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "number"
    },
    "name": {
      "description": "Nombre del negocio (tenant)",
      "type": "string"
    },
    "trial_end_at": {
      "description": "Escrito por Mission Control.",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    }
  },
  "required": [
    "name",
    "billing_status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}