{
  "name": "SupportTicketMessage",
  "properties": {
    "body": {
      "type": "string"
    },
    "business_id": {
      "description": "Tenant (Business.id) due\u00f1o del ticket padre",
      "type": "string"
    },
    "ticket_id": {
      "description": "SupportTicket.id al que pertenece este mensaje",
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "ticket_id",
    "body"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.business_id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.business_id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "staff"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}