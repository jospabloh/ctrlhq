{
  "name": "SupportTicket",
  "properties": {
    "business_id": {
      "description": "Tenant (Business.id) que abre el ticket",
      "type": "string"
    },
    "category": {
      "default": "soporte",
      "enum": [
        "soporte",
        "mejora"
      ],
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "default": "submitted",
      "enum": [
        "submitted",
        "resolved"
      ],
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "synced_to_mission_control": {
      "default": false,
      "description": "true una vez que el ingest HMAC de Mission Control confirm\u00f3 la escritura en su bodega (tickets)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "boolean"
    }
  },
  "required": [
    "business_id",
    "subject",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.business_id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.business_id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "staff"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.business_id": "{{user.data.business_id}}"
            },
            {
              "user_condition": {
                "role": "business_admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}